# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. The values below are for LOCAL DEVELOPMENT ONLY.

# --- Gateway ---------------------------------------------------------------
# Host port for http://localhost (UI at /, API at /api).
GATEWAY_PORT=80

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=keygate
POSTGRES_PASSWORD=keygate-dev-only
POSTGRES_DB=keygate
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=keygate-dev-only
REDIS_PORT=6379

# --- Mailpit (local email catcher, UI at http://localhost:8025) -------------
MAILPIT_UI_PORT=8025

# --- API (all settings use the KEYGATE_ prefix) ----------------------------
# Server-side HMAC key (CSRF tokens, decoy credential IDs). Production: generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KEYGATE_SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
# The exact origin your browser uses for Keygate. WebAuthn checks it on every ceremony.
# If you change GATEWAY_PORT to e.g. 8080, set this to http://localhost:8080.
KEYGATE_PUBLIC_URL=http://localhost
# Registrable domain passkeys are bound to (no scheme, no port).
KEYGATE_WEBAUTHN_RP_ID=localhost
# development | test | production
KEYGATE_ENVIRONMENT=development
KEYGATE_LOG_LEVEL=INFO
# false = human-readable console logs, true = JSON
KEYGATE_LOG_JSON=false

# --- Social login (optional; see README "Social login setup") --------------
# Leave empty to hide a provider. Callback URLs to register with the provider:
#   GitHub: http://localhost/api/auth/social/github/callback
#   Google: http://localhost/api/auth/social/google/callback
KEYGATE_GITHUB_CLIENT_ID=
KEYGATE_GITHUB_CLIENT_SECRET=
KEYGATE_GOOGLE_CLIENT_ID=
KEYGATE_GOOGLE_CLIENT_SECRET=
